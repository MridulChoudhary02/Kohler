# Environment variables for Kohler Hospital system
# Copy to .env and fill in your values

# PostgreSQL connection strings
DATABASE_URL=postgresql+asyncpg://kohler:kohler@localhost:5432/kohler_hospital
SYNC_DATABASE_URL=postgresql+psycopg2://kohler:kohler@localhost:5432/kohler_hospital

# App settings
DEBUG=false

# LLM settings (Phase 7)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=your-key-here
