# Environment variables for Kohler Hospital system
# Copy to .env and fill in your values

# PostgreSQL connection strings
DATABASE_URL=postgresql+asyncpg://kohler:kohler@localhost:5432/kohler_hospital
SYNC_DATABASE_URL=postgresql+psycopg2://kohler:kohler@localhost:5432/kohler_hospital

# App settings
DEBUG=false

# LLM settings (Phase 7)
# Primary provider — Groq (fast, free tier available)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-key-here

# Kept for backward compatibility if switching back to OpenAI
# OPENAI_API_KEY=your-openai-key-here
